{
  "name": "@kubohiroya/turbowarp-document-data",
  "version": "0.6.0-rc.0",
  "description": "Persistent YAML/JSON source documents and HTML/Markdown document trees for TurboWarp.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-document-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-data.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-document-data/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "document",
    "html",
    "markdown",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "schemas/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && pnpm run typecheck:source-integration",
    "build": "vite build && node scripts/build-composition.mjs && pnpm run build:source-integration",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts",
    "test": "vitest run tests && pnpm run test:source-integration",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/check-docs.ts",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs",
    "build:composition": "node scripts/build-composition.mjs && pnpm run build:source-integration",
    "build:source-integration": "tsc -p tsconfig.source-integration.json",
    "test:source-integration": "node --test test-source/*.test.ts",
    "typecheck:source-integration": "tsc --noEmit -p tsconfig.source-integration.json && tsc --noEmit -p test-source"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-yaml-json": "0.9.0-rc.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "parse5": "^8.0.1",
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0",
    "@kubohiroya/turbowarp-document-source": "0.2.0-rc.0"
  },
  "exports": {
    "./composition": {
      "types": "./src/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./source-documents": {
      "types": "./src/source-documents.d.ts",
      "import": "./dist/source-documents.js"
    },
    "./extension": "./dist/document-data.js",
    "./package.json": "./package.json",
    "./document-source": {
      "types": "./dist/source-integration/index.d.ts",
      "import": "./dist/source-integration/index.js"
    },
    "./project-views": {
      "types": "./dist/source-integration/project-views.d.ts",
      "import": "./dist/source-integration/project-views.js"
    },
    "./view-metadata": {
      "types": "./dist/source-integration/view-metadata.d.ts",
      "import": "./dist/source-integration/view-metadata.js"
    },
    "./document-views": {
      "types": "./dist/source-integration/document-views.d.ts",
      "import": "./dist/source-integration/document-views.js"
    },
    "./assets/yaml-file.svg": "./assets/yaml-file.svg"
  },
  "sideEffects": [
    "./src/index.ts",
    "./dist/document-data.js"
  ]
}
