{
  "name": "@kubohiroya/turbowarp-document-data",
  "version": "0.1.0",
  "description": "Named HTML and Markdown document trees for TurboWarp and HTTP response bodies.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-document-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-data.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-document-data/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "document",
    "html",
    "markdown",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-named-data": "^0.1.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/check-docs.ts",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-named-data": "link:../turbowarp-named-data",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "parse5": "^8.0.1"
  }
}
