{
  "name": "@kubohiroya/turbowarp-document-data",
  "version": "0.4.0",
  "description": "Named HTML and Markdown document trees for TurboWarp and HTTP response bodies.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-document-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-document-data.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-document-data/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "document",
    "html",
    "markdown",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "schemas/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-named-data": "^0.7.0"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/check-docs.ts",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-named-data": "^0.7.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "parse5": "^8.0.1"
  },
  "gitHead": "2463e2b619b97bbea7b878246f97a69a563b708e",
  "x-turbowarp-source": {
    "revision": "2463e2b619b97bbea7b878246f97a69a563b708e",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
