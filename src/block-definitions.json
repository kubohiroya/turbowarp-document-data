{
  "extensionName": "Document Data",
  "menus": {"documentFormat":{"acceptReporters":true,"items":["html","markdown"]},"sourceDocuments":{"acceptReporters":false,"items":["—"]}},
  "blocks": [
    {"opcode":"parseHtml","blockType":"COMMAND","text":"parse HTML [TEXT] as document [NAME]","description":"Parse HTML into a target-local named document tree. This does not sanitize HTML.","arguments":{"TEXT":{"type":"STRING","defaultValue":"<p>Hello</p>"},"NAME":{"type":"STRING","defaultValue":"page"}}},
    {"opcode":"parseMarkdown","blockType":"COMMAND","text":"parse Markdown [TEXT] as document [NAME]","description":"Parse Markdown into a target-local named syntax tree.","arguments":{"TEXT":{"type":"STRING","defaultValue":"# Hello"},"NAME":{"type":"STRING","defaultValue":"page"}}},
    {"opcode":"hasDocument","blockType":"BOOLEAN","text":"document [NAME] exists?","description":"Report whether the current target has the named document.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"}}},
    {"opcode":"deleteDocument","blockType":"COMMAND","text":"delete document [NAME]","description":"Delete the named document from the current target.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"}}},
    {"opcode":"documentKind","blockType":"REPORTER","text":"kind of document [NAME]","description":"Return html or markdown.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"}}},
    {"opcode":"getDocumentText","blockType":"REPORTER","text":"text in document [NAME] at [LOCATION]","description":"Get text at the root, a numeric tree path, or a simple HTML selector.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"},"LOCATION":{"type":"STRING","defaultValue":"$"}}},
    {"opcode":"replaceDocumentText","blockType":"COMMAND","text":"replace text in document [NAME] at [LOCATION] with [TEXT]","description":"Immutably replace text at the selected node.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"},"LOCATION":{"type":"STRING","defaultValue":"$"},"TEXT":{"type":"STRING","defaultValue":"Hello"}}},
    {"opcode":"serializeDocument","blockType":"REPORTER","text":"serialize document [NAME] as [FORMAT]","description":"Deterministically serialize a document in its native format. Cross-format conversion is rejected as lossy.","arguments":{"NAME":{"type":"STRING","defaultValue":"page"},"FORMAT":{"type":"STRING","defaultValue":"html","menu":"documentFormat"}}},
    {"opcode":"createYamlSource","blockType":"COMMAND","text":"store YAML [TEXT] as source document [NAME] file [FILENAME]","description":"Validate YAML and retain its exact source in SB3 extension storage. Enabled by startup DOCUMENT_SOURCE.","arguments":{"TEXT":{"type":"STRING","defaultValue":"value: example\n"},"NAME":{"type":"STRING","defaultValue":"settings"},"FILENAME":{"type":"STRING","defaultValue":"settings.yaml"}}},
    {"opcode":"createJsonSource","blockType":"COMMAND","text":"store JSON [TEXT] as source document [NAME] file [FILENAME]","description":"Validate JSON and retain its exact source in SB3 extension storage. Enabled by startup DOCUMENT_SOURCE.","arguments":{"TEXT":{"type":"STRING","defaultValue":"{\"value\":\"example\"}"},"NAME":{"type":"STRING","defaultValue":"settings"},"FILENAME":{"type":"STRING","defaultValue":"settings.json"}}},
    {"opcode":"hasSourceDocument","blockType":"BOOLEAN","text":"source document [NAME] exists?","description":"Report whether the current project owns a persistent source document.","arguments":{"NAME":{"type":"STRING","defaultValue":"settings"}}},
    {"opcode":"getSourceDocument","blockType":"REPORTER","text":"original source of document [NAME]","description":"Return the original YAML/JSON text including comments and line endings.","arguments":{"NAME":{"type":"STRING","defaultValue":"settings"}}},
    {"opcode":"sourceDocumentFormat","blockType":"REPORTER","text":"format of source document [NAME]","description":"Return yaml or json without converting the source.","arguments":{"NAME":{"type":"STRING","defaultValue":"settings"}}},
    {"opcode":"deleteSourceDocument","blockType":"COMMAND","text":"delete source document [NAME]","description":"Remove one persistent source document from the project.","arguments":{"NAME":{"type":"STRING","defaultValue":"settings"}}},
    {"opcode":"sourceDocument","blockType":"HAT","text":"embedded document [DOCUMENT]","description":"Inert declaration referring to a persistent source document. It never executes a document.","arguments":{"DOCUMENT":{"type":"STRING","defaultValue":"","menu":"sourceDocuments"}}}
  ]
}
